{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:e2e:prepare": "node tests/Browser/prepare.mjs",
        "test:e2e": "npm run test:e2e:prepare && playwright test",
        "test:e2e:headed": "npm run test:e2e:prepare && playwright test --headed",
        "test:load": "npm run test:e2e:prepare && node tests/Performance/http-smoke.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
